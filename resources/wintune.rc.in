#include "resource.h"

#include <windows.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

/* Version integers filled by CMake configure_file. */
#define WT_VER_MAJOR @WINTUNE_VERSION_MAJOR@
#define WT_VER_MINOR @WINTUNE_VERSION_MINOR@
#define WT_VER_PATCH @WINTUNE_VERSION_PATCH@
#define WT_VER_BUILD 0

IDI_WINTUNE ICON "wintune.ico"

/* Embedded application manifest (asInvoker, longPathAware, Win10/11). */
1 24 "wintune.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WT_VER_MAJOR,WT_VER_MINOR,WT_VER_PATCH,WT_VER_BUILD
 PRODUCTVERSION WT_VER_MAJOR,WT_VER_MINOR,WT_VER_PATCH,WT_VER_BUILD
 FILEFLAGSMASK  0x3fL
#ifdef NDEBUG
 FILEFLAGS 0x0L
#else
 FILEFLAGS 0x1L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WinTune"
            VALUE "FileDescription",  "WinTune - native Windows performance diagnostics"
            VALUE "FileVersion",      "@WINTUNE_VERSION_FULL@"
            VALUE "InternalName",     "wintune"
            VALUE "LegalCopyright",   "Copyright (c) WinTune contributors. MIT License."
            VALUE "OriginalFilename", "wintune.exe"
            VALUE "ProductName",      "WinTune"
            VALUE "ProductVersion",   "@WINTUNE_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
